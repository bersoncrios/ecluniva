{
  "name": "quadrei",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node scripts/angular-env.mjs serve hml",
    "dev": "npm start",
    "build": "npm run build:hml",
    "build:hml": "node scripts/angular-env.mjs build hml",
    "build:prod": "node scripts/angular-env.mjs build prod",
    "build:vercel": "node scripts/vercel-build.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:rules": "node --test --test-concurrency=1 tests/emulator/*.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-societas --only auth,firestore \"npm run test:rules\"",
    "test:ui": "node --test tests/browser/*.test.mjs",
    "test:local": "firebase emulators:exec --project demo-societas --only auth,firestore \"node scripts/qa-local.mjs\"",
    "test:attendance:optimized": "firebase emulators:exec --project demo-societas --only auth,firestore \"node scripts/qa-attendance-optimized.mjs\""
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24 <25"
  },
  "dependencies": {
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/fire": "20.0.1",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/platform-browser-dynamic": "20.3.34",
    "@angular/router": "20.3.34",
    "docx": "9.15.4",
    "firebase": "11.10.0",
    "firebase-admin": "^13.6.0",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "qrcode": "^1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.2",
    "@angular/cli": "20.3.2",
    "@angular/compiler-cli": "20.3.34",
    "@firebase/rules-unit-testing": "4.0.1",
    "@tailwindcss/postcss": "4.0.3",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "14.27.0",
    "jsqr": "^1.4.0",
    "playwright": "1.50.1",
    "tailwindcss": "4.0.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "enhanced-resolve": "5.18.4",
    "@tailwindcss/node": "4.0.3",
    "@tailwindcss/oxide": "4.0.3"
  }
}

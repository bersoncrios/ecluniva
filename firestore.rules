rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsSociety(societyId) {
      return signedIn()
        && get(/databases/$(database)/documents/societies/$(societyId)).data.ownerId == request.auth.uid;
    }

    function text(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function requiredName(value, maximum) {
      return text(value, maximum) && value.size() >= 2
        && value.matches('^\\S[\\s\\S]*\\S$');
    }

    function validSociety(data) {
      return data.keys().hasAll(['ownerId', 'churchName', 'type', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'churchName', 'type', 'name', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && requiredName(data.churchName, 160)
        && data.type in ['UPH', 'SAF', 'UMP', 'UCP', 'UPA']
        && requiredName(data.name, 120)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function civilDay(parts) {
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let lastDay = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      let today = request.time - duration.value(3, 'h');
      return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= lastDay
        && (year < today.year()
          || (year == today.year() && month < today.month())
          || (year == today.year() && month == today.month() && day <= today.day()));
    }

    function validDate(value) {
      return value == null || (value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && civilDay(value.split('-')));
    }

    function validAddress(address) {
      return address is map
        && address.keys().hasAll(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && address.keys().hasOnly(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && address.postalCode is string
        && (address.postalCode == '' || address.postalCode.matches('^[0-9]{8}$'))
        && text(address.street, 160)
        && text(address.number, 20)
        && text(address.complement, 100)
        && text(address.neighborhood, 100)
        && text(address.city, 100)
        && address.state in ['', 'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'];
    }

    function validMember(data) {
      return data.keys().hasAll(['name', 'birthDate', 'receivedDate', 'office', 'address', 'phone', 'email', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'birthDate', 'receivedDate', 'office', 'address', 'phone', 'email', 'status', 'notes', 'createdAt', 'updatedAt'])
        && requiredName(data.name, 120)
        && validDate(data.birthDate) && validDate(data.receivedDate)
        && (data.birthDate == null || data.receivedDate == null || data.receivedDate >= data.birthDate)
        && text(data.office, 100)
        && validAddress(data.address)
        && data.phone is string && (data.phone == '' || data.phone.matches('^[0-9]{10,11}$'))
        && text(data.email, 254)
        && (data.email == '' || data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
        && data.status in ['active', 'inactive']
        && text(data.notes, 2000)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /societies/{societyId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && validSociety(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && validSociety(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId) && validMember(request.resource.data)
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsSociety(societyId) && validMember(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

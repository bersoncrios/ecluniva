rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsSociety(societyId) {
      return signedIn()
        && get(/databases/$(database)/documents/societies/$(societyId)).data.ownerId == request.auth.uid;
    }

    function text(value, maximum) {
      return value is string && value.size() <= maximum;
    }

    function requiredName(value, maximum) {
      return text(value, maximum) && value.size() >= 2
        && value.matches('^\\S[\\s\\S]*\\S$');
    }

    function validSociety(data) {
      return data.keys().hasAll(['ownerId', 'churchName', 'type', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'churchName', 'churchAddress', 'type', 'name', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128
        && requiredName(data.churchName, 160)
        && data.type in ['UPH', 'SAF', 'UMP', 'UCP', 'UPA']
        && requiredName(data.name, 120)
        && (!data.keys().hasAny(['churchAddress']) || validAddress(data.churchAddress))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function civilDay(parts) {
      let year = int(parts[0]);
      let month = int(parts[1]);
      let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let lastDay = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      let today = request.time - duration.value(3, 'h');
      return year >= 1 && month >= 1 && month <= 12 && day >= 1 && day <= lastDay
        && (year < today.year()
          || (year == today.year() && month < today.month())
          || (year == today.year() && month == today.month() && day <= today.day()));
    }

    function validDate(value) {
      return value == null || (value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && civilDay(value.split('-')));
    }

    function validAddress(address) {
      return address is map
        && address.keys().hasAll(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && address.keys().hasOnly(['postalCode', 'street', 'number', 'complement', 'neighborhood', 'city', 'state'])
        && address.postalCode is string
        && (address.postalCode == '' || address.postalCode.matches('^[0-9]{8}$'))
        && text(address.street, 160)
        && text(address.number, 20)
        && text(address.complement, 100)
        && text(address.neighborhood, 100)
        && text(address.city, 100)
        && address.state in ['', 'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'];
    }

    function validMember(data) {
      return data.keys().hasAll(['name', 'birthDate', 'receivedDate', 'office', 'address', 'phone', 'email', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'birthDate', 'receivedDate', 'office', 'address', 'phone', 'email', 'status', 'notes', 'createdAt', 'updatedAt'])
        && requiredName(data.name, 120)
        && validDate(data.birthDate) && validDate(data.receivedDate)
        && (data.birthDate == null || data.receivedDate == null || data.receivedDate >= data.birthDate)
        && text(data.office, 100)
        && validAddress(data.address)
        && data.phone is string && (data.phone == '' || data.phone.matches('^[0-9]{10,11}$'))
        && text(data.email, 254)
        && (data.email == '' || data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
        && data.status in ['active', 'inactive']
        && text(data.notes, 2000)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }


    function validBoardAssignment(data, societyId, assignmentId) {
      return data.keys().hasAll(['year', 'memberId', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['year', 'memberId', 'role', 'createdAt', 'updatedAt'])
        && data.year is int && data.year >= 1900 && data.year <= 2100
        && data.memberId is string && data.memberId.size() > 0 && data.memberId.size() <= 128
        && data.memberId.matches('^[^/]+$') && !(data.memberId in ['.', '..'])
        && assignmentId == string(data.year) + '_' + data.memberId
        && requiredName(data.role, 100)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/societies/$(societyId)/members/$(data.memberId));
    }

    function minuteZoneOffset(zone) {
      return zone == 'America/Noronha' ? 2 : (zone == 'America/Manaus' ? 4 : (zone == 'America/Rio_Branco' ? 5 : 3));
    }

    function validMinuteDay(data) {
      let parts = data.date.split('-');
      return data.timeZone in ['America/Araguaina', 'America/Sao_Paulo', 'America/Recife', 'America/Fortaleza', 'America/Bahia', 'America/Belem', 'America/Noronha', 'America/Manaus', 'America/Rio_Branco']
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.dayStart is timestamp && data.dayEnd is timestamp
        && data.dayStart.year() == int(parts[0])
        && data.dayStart.month() == int(parts[1])
        && data.dayStart.day() == int(parts[2])
        && data.dayStart.hours() == minuteZoneOffset(data.timeZone)
        && data.dayStart.minutes() == 0 && data.dayStart.seconds() == 0
        && data.dayStart.nanos() == 0
        && data.dayEnd == data.dayStart + duration.value(24, 'h');
    }

    function minuteNotDeleted(data) { return data.get('deletedAt', null) == null; }

    function minuteIsToday(data) {
      return request.time >= data.dayStart && request.time < data.dayEnd;
    }

    function noticeDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && noticeDay(value.split('-'));
    }
    function noticeDay(parts) {
      let year = int(parts[0]); let month = int(parts[1]); let day = int(parts[2]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      let last = month == 2 ? (leap ? 29 : 28) : (month in [4,6,9,11] ? 30 : 31);
      return year >= 1900 && year <= 2100 && month >= 1 && month <= 12 && day >= 1 && day <= last;
    }
    function noticeField(value, maximum) {
      return text(value, maximum) && value.size() > 0 && value.matches('.*\\S.*');
    }
    function validNotice(data) {
      return data.keys().hasAll(['meetingType','churchName','societyName','issueCity','issueDate','meetingDate','timeDescription','meetingPurpose','meetingLocation','address','legalBasis','agenda','presidentName','secretaryName','presidentRole','secretaryRole','revision','createdAt','updatedAt'])
        && data.keys().hasOnly(['meetingType','churchName','societyName','issueCity','issueDate','meetingDate','timeDescription','meetingPurpose','meetingLocation','address','legalBasis','agenda','presidentName','secretaryName','presidentRole','secretaryRole','revision','createdAt','updatedAt'])
        && data.meetingType in ['plenary','executive','board']
        && noticeField(data.churchName,160) && noticeField(data.societyName,240)
        && noticeField(data.issueCity,160) && noticeDate(data.issueDate) && noticeDate(data.meetingDate)
        && data.issueDate <= data.meetingDate && noticeField(data.timeDescription,160)
        && noticeField(data.meetingPurpose,160) && noticeField(data.meetingLocation,240)
        && noticeField(data.address,500) && text(data.legalBasis,1000)
        && text(data.agenda,10000) && data.agenda.split('\n').size() <= 50
        && noticeField(data.presidentName,240) && noticeField(data.secretaryName,240)
        && noticeField(data.presidentRole,160) && noticeField(data.secretaryRole,160)
        && data.revision is int && data.revision >= 0
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }

    function validMinute(data) {
      return data.keys().hasAll(['number','year','type','date','timeZone','startTime','endTime','churchName','societyName','templeAddress','logoDataUrl','convocation','scripture','preacher','openingPrayer','devotionalTime','deliberations','newMembers','hymn','closingPrayer','presidentId','secretaryId','attendance','status','revision','dayStart','dayEnd','createdAt','updatedAt','concludedAt','finalText'])
        && data.keys().hasOnly(['number','year','type','date','timeZone','startTime','endTime','churchName','societyName','meetingLocation','templeAddress','logoDataUrl','convocation','scripture','preacher','openingPrayer','devotionalTime','deliberations','newMembers','hymn','closingPrayer','presidentId','secretaryId','attendance','status','revision','dayStart','dayEnd','createdAt','updatedAt','concludedAt','finalText'])
        && data.number is int && data.number >= 1 && data.number <= 999999
        && data.year is int && data.year >= 2020 && data.year <= 2100
        && data.year == int(data.date.split('-')[0]) && validMinuteDay(data)
        && requiredName(data.type,100) && requiredName(data.churchName,160)
        && requiredName(data.societyName,160) && requiredName(data.templeAddress,500)
        && requiredName(data.get('meetingLocation', 'Templo da igreja'),160)
        && text(data.logoDataUrl,250000)
        && text(data.startTime,5) && text(data.endTime,5) && text(data.devotionalTime,5)
        && text(data.convocation,4000) && text(data.scripture,1000)
        && text(data.preacher,120) && text(data.openingPrayer,120)
        && text(data.deliberations,40000) && text(data.newMembers,10000)
        && text(data.hymn,500) && text(data.closingPrayer,120)
        && text(data.presidentId,128) && text(data.secretaryId,128)
        && data.attendance is list && data.attendance.size() <= 500
        && data.status in ['scheduled','in_progress','concluded']
        && data.revision is int && data.revision >= 0
        && data.createdAt is timestamp && data.updatedAt == request.time
        && text(data.finalText,100000)
        && (data.status == 'concluded' ? data.concludedAt == request.time && data.finalText.size() > 0
          && data.attendance.size() > 0 && data.presidentId != '' && data.secretaryId != ''
          && data.presidentId != data.secretaryId
          && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.devotionalTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && data.startTime <= data.devotionalTime && data.devotionalTime <= data.endTime
          && data.convocation.size() > 0 && data.scripture.size() > 0 && data.preacher.size() > 0
          && data.openingPrayer.size() > 0 && data.deliberations.size() > 0 && data.closingPrayer.size() > 0
          : data.concludedAt == null && data.finalText == '');
    }

    function verifiedEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') != '';
    }
    function communicationAccess(societyId) {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/societies/$(societyId)/communicationTeam/$(request.auth.uid))
        && get(/databases/$(database)/documents/societies/$(societyId)/communicationTeam/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/societies/$(societyId)/communicationTeam/$(request.auth.uid)).data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/societies/$(societyId)/communicationSettings/access).data.enabled == true
        && activeCommunicationInvite(societyId, get(/databases/$(database)/documents/societies/$(societyId)/communicationTeam/$(request.auth.uid)).data.inviteId);
    }
    function activeCommunicationInvite(societyId, inviteId) {
      let invite = get(/databases/$(database)/documents/communicationInvites/$(inviteId)).data;
      return invite.societyId == societyId && invite.status == 'accepted' && invite.acceptedBy == request.auth.uid;
    }
    function sharedBirthdayMatches(data, member) {
      let parts = member.birthDate == null ? ['0','0','0'] : member.birthDate.split('-');
      return data.keys().hasAll(['name','month','day','active']) && data.keys().hasOnly(['name','month','day','active'])
        && data.name == member.name && data.month is int && data.day is int && data.active is bool
        && data.month == int(parts[1]) && data.day == int(parts[2])
        && data.active == (member.status == 'active' && member.birthDate != null);
    }
    function birthdayProjectionRequired(societyId, memberId, creating) {
      return (exists(/databases/$(database)/documents/societies/$(societyId)/communicationSettings/access)
          && get(/databases/$(database)/documents/societies/$(societyId)/communicationSettings/access).data.enabled == true)
        || (!creating && exists(/databases/$(database)/documents/societies/$(societyId)/communicationBirthdays/$(memberId)));
    }
    function memberBirthdaySynced(societyId, memberId, member, creating) {
      return !birthdayProjectionRequired(societyId, memberId, creating)
        || sharedBirthdayMatches(getAfter(/databases/$(database)/documents/societies/$(societyId)/communicationBirthdays/$(memberId)).data, member);
    }
    function validCommunicationInvite(data, inviteId) {
      let society = get(/databases/$(database)/documents/societies/$(data.societyId)).data;
      return data.keys().hasAll(['societyId','ownerId','email','societyName','churchName','societyType','status','acceptedBy','acceptedAt','createdAt','updatedAt'])
        && data.keys().hasOnly(['societyId','ownerId','email','societyName','churchName','societyType','status','acceptedBy','acceptedAt','createdAt','updatedAt'])
        && data.societyId is string && data.societyId.size() > 0 && data.societyId.size() <= 128
        && data.societyId.matches('^[^/]+$') && data.ownerId == society.ownerId
        && data.societyName == society.name && data.churchName == society.churchName && data.societyType == society.type
        && text(data.email,254) && data.email == data.email.lower()
        && data.email.matches('^[^\\s/@]+@[^\\s/@]+\\.[^\\s/@]+$')
        && inviteId == data.societyId + '__' + data.email
        && data.status in ['pending','accepted','revoked'] && text(data.acceptedBy,128)
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function acceptingInvite(data, inviteId) {
      return verifiedEmail() && resource.data.status == 'pending' && data.status == 'accepted'
        && resource.data.email == request.auth.token.email.lower() && data.acceptedBy == request.auth.uid
        && data.acceptedAt == request.time
        && data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','acceptedAt','updatedAt'])
        && getAfter(/databases/$(database)/documents/societies/$(data.societyId)/communicationTeam/$(request.auth.uid)).data.active == true
        && getAfter(/databases/$(database)/documents/societies/$(data.societyId)/communicationTeam/$(request.auth.uid)).data.inviteId == inviteId;
    }
    function validCommunicationTeam(data, userId) {
      return data.keys().hasAll(['userId','email','inviteId','active','createdAt','updatedAt'])
        && data.keys().hasOnly(['userId','email','inviteId','active','createdAt','updatedAt'])
        && data.userId == userId && text(data.email,254) && text(data.inviteId,400)
        && data.active is bool && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function joiningCommunicationTeam(societyId, userId, data) {
      let invite = getAfter(/databases/$(database)/documents/communicationInvites/$(data.inviteId)).data;
      return verifiedEmail() && userId == request.auth.uid && data.active == true
        && data.email == request.auth.token.email.lower() && invite.email == data.email
        && invite.societyId == societyId && invite.status == 'accepted' && invite.acceptedBy == userId
        && invite.acceptedAt == request.time;
    }
    function validCardIdentity(data) {
      return data.keys().hasAll(['primaryColor','accentColor','logoDataUrl','messageTemplate','updatedAt','updatedBy'])
        && data.keys().hasOnly(['primaryColor','accentColor','logoDataUrl','messageTemplate','updatedAt','updatedBy'])
        && data.primaryColor is string && data.primaryColor.matches('^#[0-9a-fA-F]{6}$')
        && data.accentColor is string && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && text(data.logoDataUrl,250000) && (data.logoDataUrl == '' || data.logoDataUrl.matches('^data:image/(png|jpeg);base64,[A-Za-z0-9+/=]+$'))
        && text(data.messageTemplate,1000) && data.messageTemplate.size() >= 10
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }
    function birthdayOccurrenceMatches(person, date) {
      let parts = date.split('-'); let year = int(parts[0]);
      let leap = year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
      return person.active == true && year >= 2020 && year <= 2100 && int(parts[1]) == person.month
        && int(parts[2]) == (person.month == 2 && person.day == 29 && !leap ? 28 : person.day);
    }
    function validPublication(data, publicationId, societyId) {
      return data.keys().hasAll(['memberId','date','status','revision','updatedBy','updatedAt'])
        && data.keys().hasOnly(['memberId','date','status','revision','updatedBy','updatedAt'])
        && data.memberId is string && data.memberId.size() > 0 && data.memberId.size() <= 128 && data.memberId.matches('^[^/]+$')
        && noticeDate(data.date) && publicationId == data.memberId + '_' + data.date
        && birthdayOccurrenceMatches(get(/databases/$(database)/documents/societies/$(societyId)/communicationBirthdays/$(data.memberId)).data,data.date)
        && data.status in ['pending','prepared','published'] && data.revision is int && data.revision >= 0
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    match /communicationInvites/{inviteId} {
      allow get: if signedIn() && ((resource == null && ownsSociety(inviteId.split('__')[0]))
        || (resource != null && (ownsSociety(resource.data.societyId) || (verifiedEmail() && resource.data.email == request.auth.token.email.lower()))));
      allow list: if signedIn() && (ownsSociety(resource.data.societyId) || (verifiedEmail() && resource.data.email == request.auth.token.email.lower()));
      allow create: if signedIn() && ownsSociety(request.resource.data.societyId)
        && validCommunicationInvite(request.resource.data,inviteId)
        && request.resource.data.status == 'pending' && request.resource.data.acceptedBy == '' && request.resource.data.acceptedAt == null
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/societies/$(request.resource.data.societyId)/communicationSettings/access).data.enabled == true;
      allow update: if signedIn() && validCommunicationInvite(request.resource.data,inviteId)
        && request.resource.data.createdAt == resource.data.createdAt
        && (acceptingInvite(request.resource.data,inviteId)
          || (ownsSociety(resource.data.societyId)
            && ((request.resource.data.status == 'revoked' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
              || (resource.data.status == 'revoked' && request.resource.data.status == 'pending'
                && request.resource.data.acceptedBy == '' && request.resource.data.acceptedAt == null
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','acceptedAt','updatedAt'])))));
      allow delete: if false;
    }

    // Capability links expose meeting metadata, never the membership roster.
    match /plenaryAttendance/{token} {
      function linkedMinute(data) {
        return get(/databases/$(database)/documents/societies/$(data.societyId)/minutes/$(data.minuteId)).data;
      }
      function validSession(data) {
        let minute = linkedMinute(data);
        return data.keys().hasAll(['societyId','minuteId','title','date','timeZone','open'])
          && data.keys().hasOnly(['societyId','minuteId','title','date','timeZone','open'])
          && text(data.title,220) && data.date == minute.date && data.timeZone == minute.timeZone && data.open is bool
          && getAfter(/databases/$(database)/documents/societies/$(data.societyId)/attendanceSessions/$(data.minuteId)).data.token == token
          && (!data.open || (minuteNotDeleted(minute) && minuteIsToday(minute) && minute.status != 'concluded'));
      }
      allow get: if token.matches('^[a-f0-9]{48}$');
      allow list, delete: if false;
      allow create: if token.matches('^[a-f0-9]{48}$') && ownsSociety(request.resource.data.societyId) && validSession(request.resource.data);
      allow update: if ownsSociety(resource.data.societyId) && validSession(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['open']);
      match /requests/{requestId} {
        function session() {return get(/databases/$(database)/documents/plenaryAttendance/$(token)).data;}
        function requestOwner() {return ownsSociety(session().societyId);}
        function accepting() {
          let data = session();
          let minute = linkedMinute(data);
          return data.open && minuteNotDeleted(minute) && minuteIsToday(minute) && minute.status != 'concluded';
        }
        allow get: if token.matches('^[a-f0-9]{48}$') && requestId.matches('^[a-f0-9]{48}$');
        allow list: if requestOwner();
        allow create: if requestId.matches('^[a-f0-9]{48}$') && accepting()
          && request.resource.data.keys().hasAll(['name','code','status','memberId','createdAt','processedAt'])
          && request.resource.data.keys().hasOnly(['name','code','status','memberId','createdAt','processedAt'])
          && requiredName(request.resource.data.name,120) && request.resource.data.name.matches('.*\\s+.*')
          && request.resource.data.code == get(/databases/$(database)/documents/societies/$(session().societyId)/attendanceSessions/$(session().minuteId)).data.code
          && request.resource.data.status == 'pending' && request.resource.data.memberId == ''
          && request.resource.data.createdAt == request.time && request.resource.data.processedAt == null;
        allow update: if requestOwner() && resource.data.status == 'pending'
          && minuteNotDeleted(linkedMinute(session())) && minuteIsToday(linkedMinute(session())) && linkedMinute(session()).status != 'concluded'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','memberId','processedAt'])
          && request.resource.data.status in ['confirmed','duplicate','rejected']
          && text(request.resource.data.memberId,128) && request.resource.data.processedAt == request.time
          && (request.resource.data.status == 'rejected' ? request.resource.data.memberId == ''
            : getAfter(/databases/$(database)/documents/societies/$(session().societyId)/members/$(request.resource.data.memberId)).data.status == 'active');
        allow delete: if false;
      }
    }

    match /societies/{societyId} {
      allow get: if ownsSociety(societyId) || communicationAccess(societyId);
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn() && validSociety(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && validSociety(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;


      match /attendanceSessions/{minuteId} {
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId)
          && request.resource.data.keys().hasAll(['token','code']) && request.resource.data.keys().hasOnly(['token','code'])
          && request.resource.data.token.matches('^[a-f0-9]{48}$') && request.resource.data.code.matches('^[0-9]{6}$')
          && minuteNotDeleted(get(/databases/$(database)/documents/societies/$(societyId)/minutes/$(minuteId)).data)
          && request.time < get(/databases/$(database)/documents/societies/$(societyId)/minutes/$(minuteId)).data.dayEnd
          && get(/databases/$(database)/documents/societies/$(societyId)/minutes/$(minuteId)).data.status != 'concluded'
          && getAfter(/databases/$(database)/documents/plenaryAttendance/$(request.resource.data.token)).data.societyId == societyId
          && getAfter(/databases/$(database)/documents/plenaryAttendance/$(request.resource.data.token)).data.minuteId == minuteId;
        allow update: if ownsSociety(societyId) && request.resource.data == resource.data;
        allow delete: if false;
      }
      match /minuteCounters/{yearId} {
        allow read: if ownsSociety(societyId);
        allow create, update: if ownsSociety(societyId)
          && request.resource.data.keys().hasAll(['year','value','minuteId','updatedAt'])
          && request.resource.data.keys().hasOnly(['year','value','minuteId','updatedAt'])
          && request.resource.data.year is int && yearId == string(request.resource.data.year)
          && request.resource.data.value is int
          && request.resource.data.value > 0
          && request.resource.data.minuteId == yearId + '_' + string(request.resource.data.value)
          && request.resource.data.updatedAt == request.time
          && !exists(/databases/$(database)/documents/societies/$(societyId)/minutes/$(request.resource.data.minuteId))
          && getAfter(/databases/$(database)/documents/societies/$(societyId)/minutes/$(request.resource.data.minuteId)).data.number == request.resource.data.value;
        allow delete: if false;
      }
      match /minuteNumbers/{numberId} {
        function validNumberReservation(data) {
          return data.keys().hasAll(['year','number','minuteId','updatedAt'])
            && data.keys().hasOnly(['year','number','minuteId','updatedAt'])
            && data.year is int && data.year >= 2020 && data.year <= 2100
            && data.number is int && data.number >= 1 && data.number <= 999999
            && numberId == string(data.year) + '_' + string(data.number)
            && data.minuteId is string && data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/societies/$(societyId)/minutes/$(data.minuteId)).data.year == data.year
            && getAfter(/databases/$(database)/documents/societies/$(societyId)/minutes/$(data.minuteId)).data.number == data.number
            && getAfter(/databases/$(database)/documents/societies/$(societyId)/minutes/$(data.minuteId)).data.createdAt == request.time;
        }
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId) && validNumberReservation(request.resource.data)
          && !exists(/databases/$(database)/documents/societies/$(societyId)/minutes/$(request.resource.data.minuteId));
        allow update: if ownsSociety(societyId) && validNumberReservation(request.resource.data)
          && get(/databases/$(database)/documents/societies/$(societyId)/minutes/$(resource.data.minuteId)).data.deletedAt != null;
        allow delete: if ownsSociety(societyId)
          && getAfter(/databases/$(database)/documents/societies/$(societyId)/minutes/$(resource.data.minuteId)).data.deletedAt == request.time;
      }
      match /minutes/{minuteId} {
        function validDeletion() {
          let data=request.resource.data;
          let number=resource.data.number;
          let padded=number < 10 ? '00' + string(number) : (number < 100 ? '0' + string(number) : string(number));
          let sessionPath=/databases/$(database)/documents/societies/$(societyId)/attendanceSessions/$(minuteId);
          return minuteNotDeleted(resource.data)
            && data.diff(resource.data).affectedKeys().hasOnly(['deletedAt','deletedBy','deletionReason','deletionConfirmation','revision','updatedAt'])
            && data.deletedAt == request.time && data.updatedAt == request.time && data.deletedBy == request.auth.uid
            && requiredName(data.deletionReason,500) && data.deletionReason.size() >= 10
            && data.deletionConfirmation == 'EXCLUIR ATA ' + padded
            && data.revision == resource.data.revision + 1
            && (!exists(sessionPath) || getAfter(/databases/$(database)/documents/plenaryAttendance/$(get(sessionPath).data.token)).data.open == false);
        }
        allow update: if request.resource.data.keys().hasAny(['deletedAt']) && ownsSociety(societyId) && validDeletion();
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId) && validMinute(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.revision == 0 && request.resource.data.status == 'scheduled'
          && request.resource.data.attendance.size() == 0
          && request.resource.data.presidentId == '' && request.resource.data.secretaryId == ''
          && request.time < request.resource.data.dayEnd
          && getAfter(/databases/$(database)/documents/societies/$(societyId)/minuteNumbers/$(string(request.resource.data.year) + '_' + string(request.resource.data.number))).data.minuteId == minuteId
          && getAfter(/databases/$(database)/documents/societies/$(societyId)/minuteNumbers/$(string(request.resource.data.year) + '_' + string(request.resource.data.number))).data.updatedAt == request.time;
        allow update: if ownsSociety(societyId) && minuteNotDeleted(resource.data) && resource.data.status != 'concluded'
          && validMinute(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','startTime','endTime','churchName','societyName','meetingLocation','templeAddress','logoDataUrl','convocation','scripture','preacher','openingPrayer','devotionalTime','deliberations','newMembers','hymn','closingPrayer','presidentId','secretaryId','attendance','status','revision','updatedAt','concludedAt','finalText'])
          && request.resource.data.revision == resource.data.revision + 1
          && (request.time < resource.data.dayStart
            ? request.resource.data.status == 'scheduled' && request.resource.data.presidentId == '' && request.resource.data.secretaryId == ''
            : request.resource.data.status in ['in_progress','concluded'])
          && (minuteIsToday(resource.data) || request.resource.data.attendance == resource.data.attendance);
        allow delete: if false;
      }

      match /notices/{noticeId} {
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId) && validNotice(request.resource.data)
          && request.resource.data.revision == 0 && request.resource.data.createdAt == request.time;
        allow update: if ownsSociety(societyId) && validNotice(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /boardAssignments/{assignmentId} {
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId)
          && validBoardAssignment(request.resource.data, societyId, assignmentId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsSociety(societyId)
          && validBoardAssignment(request.resource.data, societyId, assignmentId)
          && request.resource.data.year == resource.data.year
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsSociety(societyId);
      }

      match /communicationBirthdays/{memberId} {
        allow read: if ownsSociety(societyId) || (communicationAccess(societyId) && resource.data.active == true);
        allow create, update: if ownsSociety(societyId)
          && sharedBirthdayMatches(request.resource.data,getAfter(/databases/$(database)/documents/societies/$(societyId)/members/$(memberId)).data);
        allow delete: if false;
      }
      match /communicationTeam/{userId} {
        allow get: if ownsSociety(societyId) || (signedIn() && userId == request.auth.uid);
        allow list: if ownsSociety(societyId);
        allow create: if validCommunicationTeam(request.resource.data,userId)
          && joiningCommunicationTeam(societyId,userId,request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if validCommunicationTeam(request.resource.data,userId) && request.resource.data.createdAt == resource.data.createdAt
          && (joiningCommunicationTeam(societyId,userId,request.resource.data)
            || (ownsSociety(societyId) && request.resource.data.active == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt'])));
        allow delete: if false;
      }
      match /communicationSettings/{settingId} {
        allow read: if ownsSociety(societyId) || communicationAccess(societyId);
        allow create, update: if ownsSociety(societyId)
          && ((settingId == 'access' && request.resource.data.keys().hasAll(['enabled','updatedAt'])
            && request.resource.data.keys().hasOnly(['enabled','updatedAt']) && request.resource.data.enabled == true && request.resource.data.updatedAt == request.time)
            || (settingId == 'identity' && validCardIdentity(request.resource.data)));
        allow delete: if false;
      }
      match /birthdayPublications/{publicationId} {
        allow read: if ownsSociety(societyId) || communicationAccess(societyId);
        allow create: if (ownsSociety(societyId) || communicationAccess(societyId)) && validPublication(request.resource.data,publicationId,societyId)
          && request.resource.data.revision == 0;
        allow update: if (ownsSociety(societyId) || communicationAccess(societyId)) && validPublication(request.resource.data,publicationId,societyId)
          && request.resource.data.memberId == resource.data.memberId && request.resource.data.date == resource.data.date
          && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if ownsSociety(societyId);
        allow create: if ownsSociety(societyId) && validMember(request.resource.data)
          && request.resource.data.status == 'active'
          && memberBirthdaySynced(societyId,memberId,request.resource.data,true)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsSociety(societyId) && validMember(request.resource.data)
          && memberBirthdaySynced(societyId,memberId,request.resource.data,false)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /users/{userId}/billing/{societyId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
